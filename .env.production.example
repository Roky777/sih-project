# Copy to .env.production (ignored); populate on the intended host, never commit secrets.
DEPLOYMENT_DOMAIN=localhost
FLEET_ALLOWED_ORIGINS=["https://localhost:18443"]
FLEET_POSTGRES_PASSWORD=
FLEET_RABBITMQ_PASSWORD=
FLEET_RELEASE_DATABASE_URL=
FLEET_RELEASE_BROKER_URL=
FLEET_TLS_DIRECTORY=/etc/letsencrypt
FLEET_ACME_DIRECTORY=/var/lib/fleet-maintenance/acme
FLEET_PROXY_TEMPLATE=vm-bootstrap.conf.template
# Private SSH-tunnel access until a domain and publicly trusted certificate exist.
FLEET_BIND_ADDRESS=127.0.0.1
FLEET_HTTP_PORT=8080
FLEET_HTTPS_PORT=8443
# Candidate builds may use tags; release_check requires immutable sha256 image references.
FLEET_API_IMAGE=
FLEET_WEB_IMAGE=
FLEET_POSTGRES_IMAGE=
FLEET_RABBITMQ_IMAGE=
FLEET_WORKER_CONCURRENCY=1
# Copilot settings are inherited unchanged; a configured unreachable model fails runtime checks.
