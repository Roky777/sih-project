# Copy to .env for local development. Replace demonstration values outside local use.
FLEET_ENVIRONMENT=development
FLEET_DATABASE_URL=postgresql+psycopg://fleet:fleet@postgres:5432/fleet
FLEET_BROKER_URL=amqp://fleet:fleet@rabbitmq:5672//
FLEET_ARTIFACT_ROOT=/var/lib/fleet-maintenance/artifacts
FLEET_AUTHENTICATION_MODE=demo
FLEET_SECURE_COOKIES=false
FLEET_AUTO_SEED_DEMO=true
FLEET_AUTO_CREATE_SCHEMA=false
VITE_API_BASE_URL=/api
# Local inference is the default. For hosted inference, set provider=groq and a private key.
FLEET_ASSISTANT_PROVIDER=ollama
FLEET_ASSISTANT_LOCAL_ONLY=true
FLEET_ASSISTANT_MODEL=qwen3:4b-instruct
FLEET_ASSISTANT_GROQ_MODEL=openai/gpt-oss-20b
FLEET_ASSISTANT_GROQ_API_KEY=
FLEET_ASSISTANT_KEEP_ALIVE=30m
